  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ApiError"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "Ready": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status",
            "default": "ready"
          }
        },
        "type": "object",
        "title": "Ready"
      },
      "VersionInfo": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service",
            "default": "romear-api"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "v1"
          },
          "stage": {
            "type": "string",
            "title": "Stage",
            "default": "00"
          }
        },
        "type": "object",
        "title": "VersionInfo"
      }
    }
  }
