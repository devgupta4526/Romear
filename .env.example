# LOCAL DEVELOPMENT ONLY. Copy to .env; never use these credentials on a server.
POSTGRES_USER=romear_local
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=romear
POSTGRES_PORT=5432
ROMEAR_ENV=dev
ROMEAR_DATABASE_URL=postgresql+psycopg://romear_local:local_development_only@localhost:5432/romear
ROMEAR_CORS_ORIGINS=["http://localhost:5173"]
# Must remain false outside dev; no test data or OTP provider exists in Stage 00.
ROMEAR_ALLOW_TEST_DATA=false
ROMEAR_CLUB_MIN_VERIFIED_MEMBERS=4
